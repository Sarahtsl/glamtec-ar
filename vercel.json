{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/*.js": {
      "memory": 1024,
      "maxDuration": 300
    }
  },
  "rewrites": [
    {
      "source": "/ar-product.html",
      "destination": "/ar-product.html"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ], 
  "headers": [
    {
      "source": "/(.*).usdz",
      "headers": [
        { "key": "Content-Type", "value": "model/vnd.usdz+zip" }
      ]
    }
  ]

}